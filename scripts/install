#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

ynh_app_setting_set_default --key=vnc_password --value="$(ynh_string_random --length=16)"
ynh_app_setting_set_default --key=geometry --value="1280x800"

_obsidian_check_gpu

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================

ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

_obsidian_deploy_session

#=================================================
# SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd
ynh_config_add_systemd --service="$app-novnc" --template="novnc.service"

yunohost service add "$app" --description="Obsidian desktop session" --log="/var/log/$app/$app.log"
yunohost service add "$app-novnc" --description="noVNC web bridge for Obsidian" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================

ynh_script_progression "Starting $app's services..."

ynh_systemctl --service="$app" --action=start
ynh_systemctl --service="$app-novnc" --action=start

_obsidian_wait_web

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
