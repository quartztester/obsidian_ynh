#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# RETIRE THE noVNC UNIT OF THE 1.x PACKAGE
#=================================================

# ynh1 streamed through websockify on a second unit; selkies serves the stream on the app port.
if [ -e "/etc/systemd/system/$app-novnc.service" ]; then
    ynh_systemctl --service="$app-novnc" --action=stop
    ynh_hide_warnings yunohost service remove "$app-novnc"
    ynh_config_remove_systemd "$app-novnc"
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_obsidian_deploy --full_replace

ynh_obsidian_install_selkies
ynh_obsidian_remove_uploads
ynh_obsidian_prepare_vault

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Obsidian desktop session" --log="/var/log/$app/$app.log"

ynh_systemctl --service="$app" --action="restart"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
